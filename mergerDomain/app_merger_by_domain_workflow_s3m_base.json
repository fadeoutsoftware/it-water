{
  "__comment__": "configuration file for the datasets information",
  "settings": {
    "priority": {
      "reference": "environment",
      "other": "user"
    },
    "flags": {
      "update_namelist": true,
      "update_execution": true
    },
    "variables": {
      "lut": {
        "user": {          
          "time_source": null,
          "time_destination": null,
          "time_rounding": "D",
          "time_frequency": "D",
          "time_direction": "forward",
          "file_log": "{execution_name}_{domain_name}.log",
          "execution_name": "dataset_base",
          "execution_mode": "history"
        },
        "environment": {
          "domain_name": "DOMAIN_NAME",
          "time_start": "TIME_START",
          "time_end": "TIME_END",
          "path_source": "PATH_SRC",
          "path_destination": "PATH_DST",
          "path_app": "PATH_APP",
          "path_log": "PATH_LOG",
          "path_geo": "PATH_GEO",
          "path_tmp": "PATH_TMP"
        }
      },
      "format": {
        "domain_name": "string",
        "path_geo": "string",
        "path_source": "string",
        "path_destination": "string",
        "time_source": "string",
        "time_destination": "string",
        "time_direction": "string",
        "time_start": "string",
        "time_end": "string",
        "time_rounding": "string",
        "time_frequency": "string",
        "path_app": "string",
        "path_log": "string",
        "file_log": "string",
        "path_tmp": "string",
        "execution_name": "string",
        "execution_mode": "string"
      },
      "template": {
        "domain_name": "string",
        "path_geo": "string",
        "path_source": "string",
        "path_destination": "string",
        "time_source": "%Y%m%d",
        "time_destination": "%Y%m%d%H%M",
        "time_direction": "string",
        "time_start": "%Y%m%d",
        "time_end": "%Y%m%d",
        "time_rounding": "string",
        "time_frequency": "string",
        "path_app": "string",
        "path_log": "string",
        "file_log": "string",
        "path_tmp": "string",
        "execution_name": "string",
        "execution_mode": "string"
      }
    },
    "application": {
      "info": {
        "domain_name": [
          "Abruzzo",
          "Calabria",
          "Emilia_Romagna",
          "Lazio",
          "Lombardia",
          "Molise",
          "Puglia",
          "Sicilia",
          "Trentino_Alto_Adige",
          "Valle_Aosta",
          "Basilicata",
          "Campania",
          "Friuli_Venezia_Giulia",
          "Liguria",
          "Marche",
          "Piemonte",
          "Sardegna",
          "Toscana",
          "Umbria",
          "Veneto"
        ]
      },
      "time": {
        "start": "{time_start}",
        "end": "{time_end}",
        "frequency": "h",
        "format": "%Y-%m-%d %H:00"
      },
      "geo": {
        "terrain": {
          "path": "{path_geo}",
          "file_name": "griglia_ITWATER.txt"
        }
      },
      "data_source": {
        "dset_01": {
          "path": "{path_source}/Marche/%Y/%m/%d/",
          "file_name": "S3M_%Y%m%d%H00.nc.gz"
        },
        "dset_02": {
          "path": "{path_source}/Emilia_Romagna/%Y/%m/%d",
          "file_name": "S3M_%Y%m%d%H00.nc.gz"
        }
      },
      "data_destination": {
        "dset_01": {
          "path": "{path_destination}/%Y/%m/%d/",
          "file_name": "age.%Y%m%d%H%M.tiff",
          "format": "geotiff",
          "type": null,
          "mode": "grid",
          "variable": "age",
          "dims_geo": {
            "longitude": "longitude",
            "latitude": "latitude"
          },
          "vars_geo": {
            "longitude": "longitude",
            "latitude": "longitude"
          },
          "vars_data": {
            "snow_age": "SNOW_AGE"
          }
        },
        "dset_02": {
          "path": "{path_destination}/%Y/%m/%d/",
          "file_name": "albedo.%Y%m%d%H%M.tiff",
          "format": "geotiff",
          "type": null,
          "mode": "grid",
          "variable": "albedo",
          "dims_geo": {
            "longitude": "longitude",
            "latitude": "latitude"
          },
          "vars_geo": {
            "longitude": "longitude",
            "latitude": "longitude"
          },
          "vars_data": {
            "snow_albedo": "SNOW_ALBEDO"
          }
        }
      },
      "log": {
        "path": "{path_log}",
        "file_name": "example.txt"
      },
      "tmp": {
        "path": "{path_tmp}",
        "file_name": null
      }
    }
  }
}