AreaCell = "/share/drought/IT_WATER/analisi_finali/Griglie/AreaCell_Italy_200m_WGS84geog.tiff"
logo_path = '/share/drought/IT_WATER/analisi_finali/ITWATER.png'
years_list = list(range(2023, 2070, 1))

# Load shapefile
regions = gpd.read_file(shapefile_regions)

# Loop over years, load raster, multiply by area, compute sum per region
results = []
for year in years_list:
    
    #rcp 45
    # Compose filename (assuming 1st Sep, 12:00 for each year)
    # se è 2023 usa 1 settembre, altrimenti 31 agosto
    if year == 2023:
        date_str = f"{year}09011200"
        raster_path = os.path.join(
        ice_thickness_45, str(year), 
        f"09/01/Ice_Thickness.{date_str}.tiff"
    )
    else:
        date_str = f"{year}08311200"
        raster_path = os.path.join(
        ice_thickness_45, str(year), 
