# Function to compute statistics for each difference raster
def compute_regional_stats(diff_array, regions, transform, nodata=-9999):
    """Compute zonal statistics for each region"""
    stats = zonal_stats(
        regions,
        diff_array,  # Remove band dimension
        affine=transform,
        nodata=nodata,
        stats=['mean', 'min', 'max', 'std', 'sum', 'count']
    )
    return pd.DataFrame(stats)


# input
ice_thickness_45 = "/nas-watersc/s3m/IT_WATER/dati_Galileo/SWE_ghiacciai/rcp45"
ice_thickness_85 = "/nas-watersc/s3m/IT_WATER/dati_Galileo/SWE_ghiacciai/rcp85"
